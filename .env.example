# Variables de docker-compose. Copiar a ".env" (que NO se sube a git) y completar.
#   cp .env.example .env
# Para generar una clave segura:   openssl rand -base64 48

# ---- Base de datos ----
MYSQL_ROOT_PASSWORD=cambiar-clave-root-larga
DB_USER=supply
DB_PASSWORD=cambiar-clave-de-la-aplicacion

# ---- Seguridad ----
# 32 caracteres o más. Si cambia, todas las sesiones abiertas se cierran. No la compartas ni la subas a git.
JWT_SECRET=cambiar-por-un-secreto-de-48-caracteres-o-mas-aleatorio

# ---- Primer dueño de la plataforma (se crea solo si todavía no existe) ----
# Contraseña de 12 a 72 caracteres. Al primer ingreso se pide configurar el segundo factor (app autenticadora).
PLATAFORMA_ADMIN_CORREO=dueno@tu-dominio.com
PLATAFORMA_ADMIN_PASSWORD=cambiar-por-una-clave-de-12-o-mas

# ---- Publicación ----
# Puerto del equipo donde se abre la aplicación y dirección pública (para CORS).
WEB_PORT=8088
PUBLIC_URL=http://localhost:8088

# ---- Lectura de cotizaciones con IA (opcional) ----
# ninguno = solo cotizaciones por formulario | gemini | claude | ollama
IA_PROVEEDOR=ninguno
# Clave de Google AI Studio. Los documentos que se lean salen del servidor hacia Google.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

# ---- Ajustes opcionales ----
# SWAGGER_ACTIVO=false     # true publica la documentación de la API en el backend (no la publica nginx)
# API_MEMORIA=1g
# VERSION=local            # etiqueta de las imágenes
